# PostgreSQL database used by the pilot
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodsignal?schema=public"

# Required to enable AI intent extraction. Without it, requests are stored as pending manual review.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Pilot market configuration — choose one city before inviting users
PILOT_CITY=""
PILOT_COUNTRY="FR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
