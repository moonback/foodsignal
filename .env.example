# PostgreSQL database used by the pilot
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foodsignal?schema=public"

# Generate a unique random value of at least 32 characters for every environment
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Server-side AI Intent extraction and clarification. Required to accept new demands.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Pilot market configuration — choose one city before inviting users
PILOT_CITY=""
PILOT_COUNTRY="FR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Connect / Checkout — use test-mode keys during development
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Explicit platform commission in basis points (e.g. 500 = 5%). Required before checkout.
FOOD_SIGNAL_PLATFORM_FEE_BPS=""
