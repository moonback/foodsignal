generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { CUSTOMER SELLER OPERATOR }
enum DemandStatus { DRAFT ANALYZING NEEDS_CLARIFICATION OPEN COLLECTING_OFFERS PROPOSAL_READY CONFIRMED CANCELLED }
enum OfferStatus { SUBMITTED ACCEPTED REJECTED WITHDRAWN }
enum FulfillmentMode { PICKUP DELIVERY }
enum OrderStatus { CONFIRMED PREPARING READY OUT_FOR_DELIVERY COMPLETED CANCELLED }
enum PaymentStatus { PENDING PAID FAILED REFUNDED }
enum PaymentRefundStatus { PENDING SUCCEEDED FAILED }
enum StripeDisputeStatus { WARNING_NEEDS_RESPONSE WARNING_UNDER_REVIEW WARNING_CLOSED NEEDS_RESPONSE UNDER_REVIEW WON LOST }
enum NotificationType { ORDER_CONFIRMED PAYMENT_RECEIVED ORDER_STATUS_CHANGED REFUND_UPDATED DISPUTE_OPENED }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  seller       Seller?
  demands      Demand[] @relation("CustomerDemands")
  notifications Notification[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description String?
  specialties String[]
  address     String
  city        String
  postalCode  String
  latitude    Float?
  longitude  Float?
  isActive    Boolean  @default(false)
  stripeAccountId String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)
  stripeTransfersEnabled Boolean @default(false)
  products    Product[]
  offers      Offer[]
  demandRecipients DemandRecipient[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  unit        String
  description String?
  priceCents  Int
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([sellerId, category])
  @@index([sellerId, isAvailable])
}

model Demand {
  id               String       @id @default(cuid())
  customerId       String?
  customer         User?        @relation("CustomerDemands", fields: [customerId], references: [id])
  customerName     String
  customerEmail    String
  rawDescription   String
  anonymizedBrief  String
  structuredNeed  Json?
  budgetMaxCents   Int?
  requestedAt     DateTime?
  fulfillmentMode FulfillmentMode?
  city             String
  postalCode       String?
  status           DemandStatus @default(ANALYZING)
  clarification    String?
  offers           Offer[]
  recipients       DemandRecipient[]
  order            Order?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([status, city, createdAt])
}

model Offer {
  id              String      @id @default(cuid())
  demandId        String
  demand          Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller      @relation(fields: [sellerId], references: [id])
  items           Json
  subtotalCents   Int
  preparationCents Int        @default(0)
  deliveryCents   Int         @default(0)
  notes           String?
  fulfillmentModes FulfillmentMode[]
  availableAt     DateTime?
  status          OfferStatus @default(SUBMITTED)
  createdAt       DateTime    @default(now())
  @@unique([demandId, sellerId])
}

model Order {
  id              String       @id @default(cuid())
  demandId        String       @unique
  demand          Demand       @relation(fields: [demandId], references: [id])
  status          OrderStatus  @default(CONFIRMED)
  fulfillmentMode FulfillmentMode
  deliveryAddress String?
  totalCents      Int
  paymentStatus   PaymentStatus @default(PENDING)
  stripeCheckoutSessionId String? @unique
  paymentAttempt  Int          @default(0)
  stripePaymentIntentId String? @unique
  paidAt          DateTime?
  refunds         PaymentRefund[]
  disputes        StripeDispute[]
  confirmedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  href      String
  eventKey  String
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
}

model PaymentRefund {
  id             String @id @default(cuid())
  orderId        String
  order          Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stripeRefundId String? @unique
  idempotencyKey String @unique
  amountCents    Int
  status         PaymentRefundStatus @default(PENDING)
  reason         String
  requestedById  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([orderId, status])
}

model StripeDispute {
  id              String @id @default(cuid())
  stripeDisputeId String @unique
  orderId         String
  order           Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          StripeDisputeStatus
  amountCents     Int
  currency        String
  reason          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([orderId, status])
}

model DemandRecipient {
  id        String   @id @default(cuid())
  demandId  String
  demand    Demand   @relation(fields: [demandId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([demandId, sellerId])
  @@index([sellerId, createdAt])
}
