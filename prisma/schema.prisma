generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  OPERATOR
}
enum DemandStatus {
  DRAFT
  ANALYZING
  NEEDS_CLARIFICATION
  OPEN
  COLLECTING_OFFERS
  PROPOSAL_READY
  CONFIRMED
  CANCELLED
}
enum OfferStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}
enum FulfillmentMode {
  PICKUP
  DELIVERY
}
enum OrderStatus {
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         UserRole @default(CUSTOMER)
  seller       Seller?
  demands      Demand[] @relation("CustomerDemands")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Seller {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description String?
  specialties String[]
  address     String
  city        String
  postalCode  String
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(false)
  products    Product[]
  offers      Offer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  name        String
  category    String
  unit        String
  description String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([sellerId, category])
}

model Demand {
  id               String       @id @default(cuid())
  customerId       String?
  customer         User?        @relation("CustomerDemands", fields: [customerId], references: [id])
  customerName     String
  customerEmail    String
  rawDescription   String
  anonymizedBrief  String
  structuredNeed  Json?
  budgetMaxCents   Int?
  requestedAt     DateTime?
  fulfillmentMode FulfillmentMode?
  city             String
  postalCode       String?
  status           DemandStatus @default(ANALYZING)
  clarification    String?
  offers           Offer[]
  order            Order?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  @@index([status, city, createdAt])
}

model Offer {
  id              String      @id @default(cuid())
  demandId        String
  demand          Demand      @relation(fields: [demandId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          Seller      @relation(fields: [sellerId], references: [id])
  items           Json
  subtotalCents   Int
  preparationCents Int        @default(0)
  deliveryCents   Int         @default(0)
  notes           String?
  fulfillmentModes FulfillmentMode[]
  availableAt     DateTime?
  status          OfferStatus @default(SUBMITTED)
  createdAt       DateTime    @default(now())
  @@unique([demandId, sellerId])
}

model Order {
  id              String       @id @default(cuid())
  demandId        String       @unique
  demand          Demand       @relation(fields: [demandId], references: [id])
  status          OrderStatus  @default(CONFIRMED)
  fulfillmentMode FulfillmentMode
  deliveryAddress String?
  totalCents      Int
  confirmedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}
